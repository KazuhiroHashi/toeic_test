# App Store 向けのビルドと TestFlight へのアップロード。
#
#   fastlane ios release
#
# 自動署名は「開発用プロファイル」を作ろうとし、それにはテスト端末の登録が
# 最低1台必要になる(端末ゼロの CI では必ず失敗する)。そこでここでは
# 端末登録が要らない「配布用(Apple Distribution)」の証明書とプロファイルを
# API キーで直接作り、手動署名でアーカイブする。
#
# 必要な環境変数: ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_P8(.p8 の中身)

default_platform(:ios)

BUNDLE_ID = "com.bridgeaitokyo.toeic"
TEAM_ID   = "W2TSCP2QY2"

platform :ios do
  lane :release do
    # CI 用の一時キーチェーンを作る(これが無いと証明書を入れる場所が無い)
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8")
    )

    # 配布用証明書。無ければ作り、あれば使い回す。
    # 置き場所は setup_ci が作った一時キーチェーン(パスワードは空文字)を明示する。
    # 指定しないと既定の login.keychain に入れようとし、パスワードが分からず
    # 「There are no local code signing identities found」で落ちる。
    cert(
      api_key: api_key,
      keychain_path: File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db"),
      keychain_password: ""
    )

    # App Store 用プロビジョニングプロファイル
    sigh(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      force: true
    )

    # App ターゲットだけ手動署名に切り替える(SPM のパッケージ群は署名不要)
    update_code_signing_settings(
      path: "ios/App/App.xcodeproj",
      use_automatic_signing: false,
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      targets: ["App"]
    )

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { BUNDLE_ID => lane_context[SharedValues::SIGH_NAME] }
      },
      xcargs: "MARKETING_VERSION=#{ENV.fetch('MARKETING_VERSION', '1.0.0')} " \
              "CURRENT_PROJECT_VERSION=#{ENV.fetch('GITHUB_RUN_NUMBER', '1')}"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
