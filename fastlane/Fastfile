# App Store 向けのビルドと TestFlight へのアップロード。
#
#   fastlane ios release
#
# 自動署名は「開発用プロファイル」を作ろうとし、それにはテスト端末の登録が
# 最低1台必要になる(端末ゼロの CI では必ず失敗する)。そこでここでは
# 端末登録が要らない「配布用(Apple Distribution)」の証明書とプロファイルを
# API キーで直接作り、手動署名でアーカイブする。
#
# 必要な環境変数: ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_P8(.p8 の中身)

default_platform(:ios)

BUNDLE_ID = "com.bridgeaitokyo.toeic"
TEAM_ID   = "W2TSCP2QY2"

platform :ios do
  lane :release do
    # CI 用の一時キーチェーンを作る(これが無いと証明書を入れる場所が無い)
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8")
    )

    # 配布用証明書。
    #
    # CI のランナーは毎回まっさらなので、cert が作った証明書の秘密鍵は
    # 実行が終わると消える。次の実行で cert は「使える証明書が無い」と判断して
    # 新しい証明書を作ろうとするが、Apple の配布用証明書は数枚までしか
    # 作れないため、数回でエラーになる(実際に run #7 で上限に当たった)。
    #
    # そこで、初回に作った証明書を p12(パスワード付き)で書き出して
    # GitHub Actions のキャッシュに保存し、次回からはそれを取り込んで使い回す。
    keychain = File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db")
    p12_dir  = File.expand_path("../certs", __dir__)
    p12_path = File.join(p12_dir, "dist.p12")
    p12_pass = ENV.fetch("P12_PASSWORD")

    if File.exist?(p12_path)
      UI.message("保存済みの配布用証明書を取り込みます(certs/dist.p12)")
      import_certificate(
        certificate_path: p12_path,
        certificate_password: p12_pass,
        keychain_path: keychain,
        keychain_password: "",
        log_output: false
      )
    else
      UI.message("配布用証明書を新規作成し、次回のために書き出します")
      cert(
        api_key: api_key,
        keychain_path: keychain,
        keychain_password: ""
      )
      require "fileutils"
      FileUtils.mkdir_p(p12_dir)
      # 秘密鍵ごと p12 に書き出す。パスワードがログに出ないよう log: false にする
      sh("security", "export", "-k", keychain, "-t", "identities",
         "-f", "pkcs12", "-P", p12_pass, "-o", p12_path, log: false)
    end

    # App Store 用プロビジョニングプロファイル
    sigh(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      force: true
    )

    # App ターゲットだけ手動署名に切り替える(SPM のパッケージ群は署名不要)
    update_code_signing_settings(
      path: "ios/App/App.xcodeproj",
      use_automatic_signing: false,
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      targets: ["App"]
    )

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { BUNDLE_ID => lane_context[SharedValues::SIGH_NAME] }
      },
      xcargs: "MARKETING_VERSION=#{ENV.fetch('MARKETING_VERSION', '1.0.0')} " \
              "CURRENT_PROJECT_VERSION=#{ENV.fetch('GITHUB_RUN_NUMBER', '1')}"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
